---
import { Image } from 'astro:assets'

import annexDark from '@/assets/projects/annex-dark.png'
import annexLight from '@/assets/projects/annex-light.png'
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import BaseLayout from '@/layouts/base.astro'
import { getLinkTargetAttributes } from '@/lib/links'

const artifactLinks = [
  { label: 'Recorded demo', href: 'https://annex.erclx.com' },
  { label: 'GitHub', href: 'https://github.com/erclx/annex' },
]

// The sections the bar links, per the note in `jobtriage.astro`.
const navItems = [
  { id: 'why-i-built-it', label: 'why i built it' },
  { id: 'how-it-works', label: 'how it works' },
  { id: 'what-it-shows', label: 'what it shows' },
]

// The alt text is the annex README's own for the same two files.
const heroAlt =
  'The Annex landing page: a description box and twelve recorded questions'

const heroImageClass = 'block h-auto w-full'
---

<BaseLayout
  title="annex · Eric Le"
  description="annex is an agent that maps a described AI system to the EU AI Act articles that may apply, cited to the text."
  surface="case-study"
>
  <RouteBar here="annex" items={navItems} />

  <main>
    <section id="annex" class="page-inset pt-16 pb-12 md:pt-20 md:pb-16">
      <div class="prose-column mx-auto">
        <p
          data-fade
          class="text-muted-foreground text-label tracking-wide uppercase"
        >
          Project
        </p>
        <h1
          data-fade
          class="font-display text-foreground mt-4 text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          annex
        </h1>
        <p data-fade class="text-muted-foreground text-lede mt-4">
          annex is an agent for the EU AI Act. You describe an AI system, and it
          returns the articles that may apply, cited to the text, and says so
          when the Act does not settle the question.
        </p>
        <ul data-fade class="mt-6 flex flex-wrap gap-x-6">
          {
            artifactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...getLinkTargetAttributes(link.href)}
                  class="text-foreground text-label inline-flex min-h-11 min-w-11 items-center underline-offset-4 hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {
          /* The landing page the annex README opens on. The two themes are two
            files, so each shows under its own theme. */
        }
        <figure
          data-fade
          class="figure-breakout bg-card border-border/60 mt-12 overflow-hidden rounded-lg border"
        >
          <Image
            src={annexLight}
            alt={heroAlt}
            class={`${heroImageClass} dark:hidden`}
          />
          <Image
            src={annexDark}
            alt={heroAlt}
            class={`${heroImageClass} hidden dark:block`}
          />
        </figure>
      </div>
    </section>

    <section id="why-i-built-it" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          why i built it
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          I wanted to know whether retrieval still helps when a model can read
          the whole law. The Act fits in one model's context window, so the
          usual answer was no longer obvious.
        </p>
      </div>
    </section>

    <section id="how-it-works" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          how it works
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          It searches the Act and follows its own cross-references, and runs
          fully local on Ollama.
        </p>
      </div>
    </section>

    <section id="what-it-shows" class="page-inset py-16 md:py-20">
      <div class="prose-column mx-auto">
        <h2
          data-fade
          class="text-foreground font-display text-2xl leading-tight font-semibold md:text-3xl"
        >
          what it shows
        </h2>
        <p data-fade class="text-foreground text-lede mt-6">
          The public page replays recorded answers, so anyone can see what it
          returns without running it. The code is open on GitHub.
        </p>
      </div>
    </section>
  </main>

  <RouteFoot />

  <script>
    import { initWayHome } from '@/components/site/case-study/way-home'
    import { initReveal } from '@/lib/reveal'

    initReveal()
    initWayHome()
  </script>
</BaseLayout>
