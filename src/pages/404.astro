---
import RouteFoot from '@/components/site/case-study/route-foot.astro'
import RouteBar from '@/components/site/nav/route-bar.astro'
import BaseLayout from '@/layouts/base.astro'
---

{
  /* Cloudflare Pages serves a top-level `404.html` for a path with no file
    behind it and answers 404. Without one it assumes a single-page app and
    serves the homepage for every unknown path, with a 200. The route chrome
    rather than the landing bar, since the landing bar's name and theme toggle
    arrive from the hero and this page has none. */
}
<BaseLayout
  title="Page not found · Eric Le"
  description="This address leads nowhere on erclx.com. The way back is Eric Le's landing page."
  surface="case-study"
>
  <RouteBar here="Not found" items={[]} scrolls={false} />

  <main>
    <section class="page-inset pt-16 pb-8 md:pt-20 md:pb-10">
      <div class="prose-column mx-auto">
        <h1
          data-fade
          class="font-display text-foreground text-[2.25rem] leading-tight font-semibold md:text-[2.75rem]"
        >
          Page not found
        </h1>
        <p data-fade class="text-muted-foreground text-lede mt-4">
          Nothing lives at this address. The link may be old, or mistyped.
        </p>
      </div>
    </section>
  </main>

  <RouteFoot />

  {
    /* The page's `data-fade` elements start hidden once script runs, and
      nothing else here reveals them. */
  }
  <script>
    import { initReveal } from '@/lib/reveal'

    initReveal()
  </script>
</BaseLayout>
